{
  "manifest_version": 3,
  "name": "ck-auto-like-instagram",
  "version": "3.0.0",
  "description": "Likes posts from followers of target Instagram profiles you specify, at a human pace with configurable delays and limits.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_title": "ck-auto-like-instagram",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}